{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "悬浮小醒",
  "version": "0.1.0",
  "identifier": "com.xuanfuxiaoxing.desktop",
  "build": {
    "frontendDist": "../dist/renderer",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev:vite"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "悬浮小醒",
        "width": 400,
        "height": 600,
        "minWidth": 400,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "../assets/app-icon.png",
      "../assets/app-icon.ico"
    ]
  }
}
