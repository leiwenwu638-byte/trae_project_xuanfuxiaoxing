{
  "name": "desktop-health-assistant",
  "version": "0.1.0",
  "private": true,
  "description": "Lightweight Electron floating desktop assistant for todos and health reminders.",
  "main": "dist/main/index.cjs",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"vite build --config vite.main.config.ts --watch\" \"wait-on tcp:5173 dist/main/index.cjs && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 node scripts/start-electron.mjs dist/main/index.cjs\"",
    "build": "vite build && vite build --config vite.main.config.ts",
    "start": "node scripts/start-electron.mjs dist/main/index.cjs",
    "start:debug": "node scripts/start-electron.mjs dist/main/index.cjs --debug-window",
    "test": "vitest",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.1",
    "cross-env": "^10.0.0",
    "electron": "^39.2.6",
    "lucide-react": "^0.555.0",
    "postcss": "^8.5.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^3.4.18",
    "vite": "^7.2.6",
    "wait-on": "^9.0.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^27.2.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.14"
  }
}
